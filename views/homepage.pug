doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Plants
        a(href="/update-cobj") Add to this table
        table
            tr
                th Name
                th Species
                th Height (cm)
            each record in data
                tr
                    td= record.properties.name
                    td= record.properties.species
                    td= record.properties.height_cm
